<?xml version="1.0"?>
<package format="3">
  <name>livox_ros_driver2</name>
  <version>0.0.1</version>
  <description>Only the messages of Livox's livox_ros_driver2 (CustomMsg, CustomPoint), for building FAST_LIO_ROS2 without the Livox SDK.</description>
  <maintainer email="yunus.akdal@gmail.com">Yunus Ahmet AKDAL</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>std_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <export><build_type>ament_cmake</build_type></export>
</package>
